{
  "name": "slide",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "description": "Slide — AI-Powered Database Operations Platform",
  "scripts": {
    "dev": "pnpm --filter slide-api dev & pnpm --filter slide-frontend dev",
    "start": "pnpm --filter slide-api start",
    "build": "pnpm --filter slide-frontend build",
    "test": "pnpm -r test",
    "qualification:matrix": "pnpm --filter slide-api exec tsx ../../tests/qualification/coverage-matrix.ts --validate",
    "security:audit": "pnpm audit --prod --audit-level=high",
    "security:scan": "pnpm --filter slide-api exec tsx ../../tests/qualification/security-gate.ts",
    "security:test": "pnpm --filter slide-api exec vitest run src/security/database-target-policy.test.ts src/security/branding-policy.test.ts src/security/approval-execution-authorizer.test.ts src/security/http-security.test.ts src/security/log-redaction.test.ts src/security/fatal-process.test.ts src/db-connection-encryption.test.ts src/security/security-event-service.test.ts",
    "contracts:generate": "pnpm --filter slide-api exec tsx src/contracts/generate-public-api.ts",
    "contracts:check": "pnpm --filter slide-api exec tsx src/contracts/generate-public-api.ts --check",
    "release:artifact": "bash scripts/release/build-artifact.sh",
    "release:rollback-drill": "bash scripts/release/rollback-drill.sh",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/ssh2": "^1.15.5",
    "oxlint": "^0.16.0"
  },
  "pnpm": {
    "overrides": {
      "form-data": "4.0.6",
      "linkify-it": "5.0.2",
      "undici": "6.27.0"
    },
    "onlyBuiltDependencies": [
      "bcrypt",
      "esbuild",
      "oracledb"
    ]
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  }
}
