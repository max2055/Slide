# Slide — Database Operations Platform
# Copy to .env and adjust values

# ── Database ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=db_ops_ai

# ── AI / LLM ──
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250929
OPENAI_API_KEY=sk-...

# ── Auth ──
JWT_SECRET_KEY=your-secret-key-min-32-chars
# Oracle 11g requires node-oracledb Thick mode with operator-supplied Instant Client.
NODE_ORACLEDB_DRIVER_MODE=thick
NODE_ORACLEDB_CLIENT_LIB_DIR=/opt/oracle/instantclient
LD_LIBRARY_PATH=

CORS_ORIGINS=http://localhost:5173

# ── Server ──
BACKEND_PORT=3000
FRONTEND_PORT=5173
AGENT_WS_PORT=28888
# Maximum consecutive calls with the same tool arguments before the loop guard blocks one.
AGENT_LOOP_THRESHOLD=5

# ── Agent Sandbox (optional; required for execute_code) ──
SANDBOX_CONTROLLER_URL=http://sandbox-controller:3010
SANDBOX_CONTROLLER_SECRET=replace-with-a-32-character-secret
# Dedicated Docker network whose egress policy is restricted by deployment infrastructure.
SANDBOX_RESTRICTED_NETWORK=
# Digest-pinned image containing the approved network diagnostic tools (for example nmap).
SANDBOX_NETWORK_IMAGE=
# Maps logical sandbox execution profiles to digest-pinned images.
SANDBOX_EXECUTION_PROFILES={"database-network-scan":"slide-network-tools@sha256:66cc5bdc9219878a68a7b5147eb42059267af055fd9f71046a89c387b649f501"}
