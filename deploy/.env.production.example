# Public listener. Put TLS termination in front of this bind in production.
SLIDE_HTTP_BIND=127.0.0.1
SLIDE_HTTP_PORT=8080
SLIDE_PUBLIC_ORIGIN=https://slide.example.com

# Replace every placeholder with an independently generated secret.
SLIDE_DB_ROOT_PASSWORD=replace-with-random-root-password
SLIDE_DB_PASSWORD=replace-with-random-application-password
JWT_SECRET_KEY=replace-with-random-jwt-secret-at-least-32-characters
ENCRYPTION_KEY=replace-with-exactly-32-random-utf8-bytes
AGENT_APPROVAL_HMAC_KEY=replace-with-random-approval-key-at-least-32-characters
SANDBOX_CONTROLLER_SECRET=replace-with-random-controller-key-at-least-32-characters
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-with-random-initial-admin-password

# Rootless Docker owned by the dedicated Slide service account.
ROOTLESS_DOCKER_UID=1000
ROOTLESS_DOCKER_GID=1000
ROOTLESS_DOCKER_SOCKET=/run/user/1000/docker.sock
SANDBOX_WORKSPACE_ROOT=/var/lib/slide-sandbox
SANDBOX_MAX_CONCURRENT_JOBS=4
SANDBOX_IMAGES={"shell":"node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32","python":"python:3.13-alpine@sha256:399babc8b49529dabfd9c922f2b5eea81d611e4512e3ed250d75bd2e7683f4b0","node":"node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32"}
SANDBOX_EXECUTION_PROFILES={"database-network-scan":"slide-network-tools@sha256:66cc5bdc9219878a68a7b5147eb42059267af055fd9f71046a89c387b649f501"}

# Target CIDR and port allowlists are not configured through environment
# variables; the application validates target syntax and blocks special local
# or metadata addresses. Oracle 11g uses the bundled Thick-mode client.
NODE_ORACLEDB_DRIVER_MODE=thick
NODE_ORACLEDB_CLIENT_LIB_DIR=/opt/oracle/instantclient
LD_LIBRARY_PATH=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
