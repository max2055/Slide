    "findings": [
      {
        "id": "MF1",
        "current": "Subagent owner/actor and parentSessionKey exist; budget allocation can propagate parent spec.signal conditionally. No trusted chat parentRunId/credential binding or continuous chat admission is established by those mechanisms.",
        "recommended": "D4 lineage cascade and independent live admission/monitoring after normal parent completion; protect access and result delivery.",
        "proposalSection": "5.1"
      },
      {
        "id": "MF2",
        "current": "JWT verification returns ActorContext; ordinary AgentRun and actor lack verified initiating credential exp/connection binding.",
        "recommended": "Disable: all ordinary user runs; version change: old versions only; chat revoke: all ordinary user runs; JWT expiry: initiating credential only. Observer expiry does not cancel observed owner runs; reconnect cannot extend original execution expiry.",
        "proposalSection": "5.2"
      },
      {
        "id": "MF3",
        "current": "User analysis freezes full permission hash and rechecks before Provider and completion. Cron has live owner/business/resource checks; system analysis checks switches; investigation service checks its own kind/version/chat/profile/resource authority.",
        "recommended": "Keep full analysis authorizationVersion algorithm, including chat-only revocation invalidation. Preserve other background authority; no blanket background exemption.",
        "proposalSection": "5.3"
      },
      {
        "id": "D3-owner",
        "current": "Share read predicate does not check owner current active/chat authority.",
        "recommended": "Suspend read on owner chat loss/disable, retain share records and allow read after owner restoration; owner token expiry/version-only change does not suspend sharing.",
        "proposalSection": "5.4"
      }
    ],
    "futureAcceptanceCases": [
