+    expect((await repositoryA.getItemVersion('tpl-a', 'uptime', 1))!.display_name).toBe('Uptime');
+    expect((await repositoryA.latestItemVersions('tpl-a')).map(entry => entry.version)).toEqual([2]);
+    const [identity] = await poolA.query<any[]>(
