# ==================== 数据库配置 ====================
# MySQL 数据库配置（可选，目前使用模拟数据）
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/db_ops_ai

# Redis 配置（可选）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Elasticsearch 配置（可选）
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=

# MongoDB 配置（可选）
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USERNAME=admin
MONGODB_PASSWORD=

# ==================== LLM 配置 ====================
# 选择一种或多种配置，取消注释并填写你的 API Key

# --- Anthropic Claude ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- OpenAI ---
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_MODEL=gpt-4o

# --- Azure OpenAI ---
# AZURE_OPENAI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# --- Ollama (本地模型) ---
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5-coder:32b

# ==================== JWT 配置 ====================
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-min-32-chars
# Set thick and mount Oracle Instant Client 19c (or compatible) to support Oracle 11g.
NODE_ORACLEDB_DRIVER_MODE=thick
NODE_ORACLEDB_CLIENT_LIB_DIR=/opt/oracle/instantclient
LD_LIBRARY_PATH=
# Target host and port policy is enforced by the application; no target CIDR
# or port allowlist environment variables are required.
CORS_ORIGINS=http://localhost:5173
JWT_EXPIRATION_MINUTES=1440

# ==================== 服务端口配置 ====================
BACKEND_PORT=3000
FRONTEND_PORT=5173

# ==================== 日志配置 ====================
LOG_LEVEL=INFO

# Runtime T5: opt-in only after module validation and T6 rollout qualification.
# false preserves legacy chat 120s/40, invoke 120s/8, subagent 120s/25.
AGENT_RUNTIME_LONG_CHAT=false
# LONG_CHAT=true: missing BOTH timeout keys means chat has no whole-run deadline.
# Chat-specific value wins over the legacy timeout; positive integer milliseconds only.
# AGENT_CHAT_RUN_TIMEOUT_MS=600000
# AGENT_RUN_TIMEOUT_MS=120000
# Explicit iterations remain effective; LONG_CHAT chat defaults to 200 if absent.
# AGENT_MAX_ITERATIONS=40
# LONG_CHAT enforces 500 tools, 600 provider attempts, 1M total tokens (input+output),
# 12 steps without novel tool evidence, 300s chat request / 60s idle / 60s tool.
# Cron keeps job.timeout_seconds (default 300s) and 40 steps.

# Structured memory is opt-in; enabled deployments must assign a stable identity.
SLIDE_MEMORY_PIPELINE_ENABLED=false
SLIDE_MEMORY_WORKSPACE_ID=
# Request projection includes provenance and the complete reference envelope.
# Conservative UTF-8 token upper bound; 0 count/tokens disables retrieval.
SLIDE_MEMORY_RETRIEVAL_MAX_COUNT=5
SLIDE_MEMORY_RETRIEVAL_MAX_TOKENS=4096

# D1 infrastructure readiness: /api/health/ready (public boolean only).
# Standbys do not auto-promote; detailed readiness requires JWT + config:view.
METRICS_V2_COLLECTION_ENABLED=false
